# ─────────────────────────────────────────────────────────────
# CleanCity — copy to .env.local and fill in.
# .env.local is gitignored; never commit real values.
# ─────────────────────────────────────────────────────────────

# ── MongoDB Atlas ────────────────────────────────────────────
# Atlas → Connect → Drivers → Node.js. Two edits to the copied string:
#   1. replace <password> with the real one, URL-ENCODED if it has @ : / ? # [ ] %
#   2. insert the database name between the host and the "?"
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cleancity_dev?retryWrites=true&w=majority"

# ── Auth.js ──────────────────────────────────────────────────
# Generate:  npx auth secret        (or: openssl rand -base64 32)
AUTH_SECRET=""
# Local dev only; in production set this to the deployed origin.
AUTH_URL="http://localhost:3000"

# ── Google OAuth ─────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
# Authorised redirect URI must be EXACTLY:
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── App secrets ──────────────────────────────────────────────
# Generate:  openssl rand -hex 32
# Hashes IoT device tokens at rest.
HASH_PEPPER=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
